APP_ENV=prod
APP_NAME=Attend API
APP_VERSION=0.4.0

GCP_PROJECT_ID=tekforge-attend
ASSETS_BUCKET=tekforge-attend-assets
EXPORTS_BUCKET=tekforge-attend-exports

PUBLIC_WEB_BASE_URL=https://www.attend.tekforge.com.br
PUBLIC_API_BASE_URL=https://api.attend.tekforge.com.br

JWT_SECRET=change-me-local
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

ENABLE_ADMIN_BOOTSTRAP=false
ADMIN_BOOTSTRAP_PASSWORD=change-me
ADMIN_BOOTSTRAP_USERNAME=admin
ADMIN_BOOTSTRAP_EMAIL=admin@attend.local

EMAIL_ENABLED=false
EMAIL_FROM=hello@attend.local
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=false

CORS_ALLOW_ORIGINS=https://www.attend.tekforge.com.br,http://localhost:5173
